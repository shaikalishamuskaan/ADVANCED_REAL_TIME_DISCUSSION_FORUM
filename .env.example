# Local development configuration only.
# Never use these example values in production.

APP_ENV=development
LOG_LEVEL=INFO
DJANGO_SECRET_KEY=replace_with_a_unique_random_secret
RECOVERY_CODE_HMAC_KEY=replace_with_a_different_random_secret
JWT_PRIVATE_KEY_PATH=services/identity/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=services/identity/keys/jwt-public.pem
JWT_ISSUER=identity
JWT_AUDIENCE=forum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Local PostgreSQL development credentials
POSTGRES_USER=forum_dev
POSTGRES_PASSWORD=replace_with_a_local_development_password

# Shared Redis service
REDIS_URL=redis://localhost:6380/0


# Identity Outbox Relay
OUTBOX_RELAY_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

# Internal service-to-service authentication
# Use different, randomly generated secrets for each service.
SERVICE_API_KEYS={"discussion":"replace_with_discussion_service_key","notify":"replace_with_notify_service_key","realtime":"replace_with_realtime_service_key"}
SEARCH_SERVICE_KEY=replace_with_a_separate_search_export_key

# Optional overrides when running a second local checkout. Defaults:
# FRONTEND_HOST_PORT=8080
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# POSTGRES_CONTAINER_NAME=forum-postgres
# REDIS_CONTAINER_NAME=forum-redis
