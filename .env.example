# Local development configuration only.
# Never use these example values in production.

APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL development credentials
POSTGRES_USER=forum_dev
POSTGRES_PASSWORD=replace_with_a_local_development_password

# Shared Redis service
REDIS_URL=redis://localhost:6380/0


# Identity Outbox Relay
OUTBOX_RELAY_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

# Internal service-to-service authentication
# Use different, randomly generated secrets for each service.
SERVICE_API_KEYS={"discussion":"replace_with_discussion_service_key","notify":"replace_with_notify_service_key","realtime":"replace_with_realtime_service_key"}