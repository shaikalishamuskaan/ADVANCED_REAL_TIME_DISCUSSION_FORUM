APP_ENV=development

DATABASE_URL=postgresql+asyncpg://forum_dev:forum_dev_local_only@localhost:5433/notification_db

REDIS_URL=redis://localhost:6380/0

IDENTITY_BASE_URL=http://localhost:8000
IDENTITY_SERVICE_KEY=replace_with_identity_notify_service_key

JWT_PUBLIC_KEY_PATH=../identity/keys/jwt-public.pem
