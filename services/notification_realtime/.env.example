JWT_ALGORITHM=RS256

STATUS_CACHE_TTL_SECONDS=30

OUTBOX_RELAY_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

WS_MAX_SOCKETS_PER_USER=5