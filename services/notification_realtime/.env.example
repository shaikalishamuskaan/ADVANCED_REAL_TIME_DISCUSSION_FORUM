APP_ENV=development

DATABASE_URL=postgresql+asyncpg://forum_dev:replace_with_a_local_development_password@localhost:5433/notification_db

REDIS_URL=redis://localhost:6380/0

IDENTITY_BASE_URL=http://localhost:8000
IDENTITY_SERVICE_KEY=replace_with_notify_service_key

JWT_PUBLIC_KEY_PATH=../identity/keys/jwt-public.pem
JWT_ISSUER=identity
JWT_AUDIENCE=forum
JWT_ALGORITHM=RS256

STATUS_CACHE_TTL_SECONDS=30

OUTBOX_RELAY_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

WS_MAX_SOCKETS_PER_USER=5
